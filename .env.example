# Copie para .env e substitua todos os valores <...> antes de subir o ambiente:
#   cp .env.example .env
# O docker compose falha com mensagem explícita se alguma credencial obrigatória faltar.

# --- MinIO / S3 (usadas pelo MinIO e pelos scripts do pipeline) ---
AIRFLOW__S3__ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=<senha-com-8-ou-mais-caracteres>
AWS_DEFAULT_REGION=us-east-1

# --- PostgreSQL Gold (data warehouse) ---
POSTGRES_HOST=postgres-gold
POSTGRES_PORT=5432
POSTGRES_DB=gold
POSTGRES_USER=uberlandia
POSTGRES_PASSWORD=<defina-uma-senha>

# --- Airflow ---
# Banco de metadados do Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=<defina-uma-senha>
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<gere-uma-fernet-key>
# Usuário administrador da interface web (http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<defina-uma-senha>

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=<defina-uma-senha>

# --- dbt ---
# Imagem usada pelo DockerOperator para executar o dbt (tag fixa)
DBT_IMAGE=ghcr.io/dbt-labs/dbt-postgres:1.8.2
# Caminho ABSOLUTO do diretório dbt/ no host (obrigatório; usado pelo DockerOperator)
DBT_PROJECT_HOST_PATH=/caminho/absoluto/para/refresco-data-case/dbt

# --- APIs externas ---
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
